# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to GitHub.

# Azure AI Content Understanding (Optional)
CONTENT_UNDERSTANDING_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
CONTENT_UNDERSTANDING_KEY=your-key-here

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_KEY=your-key-here
AZURE_SEARCH_INDEX_NAME=campus-content-index

# Microsoft Foundry / Azure OpenAI (for agent reasoning + answer synthesis)
FOUNDRY_ENDPOINT=https://<your-foundry-resource>.openai.azure.com/
FOUNDRY_API_KEY=your-key-here
FOUNDRY_MODEL_DEPLOYMENT=gpt-4o-mini

# Azure AI Speech (Text-to-Speech audio read-aloud and Speech-to-Text voice queries)
AZURE_SPEECH_KEY=your-speech-key-here
AZURE_SPEECH_REGION=centralus

# Azure AI Translator (Multi-language query and response translation)
AZURE_TRANSLATOR_KEY=your-translator-key-here
AZURE_TRANSLATOR_REGION=centralus

# Azure Blob Storage (for persistent cloud document storage and provenance)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=campus-documents

