{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://campus-content-intelligence.onrender.com/api/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://campus-content-intelligence.onrender.com/media/$1"
    }
  ]
}